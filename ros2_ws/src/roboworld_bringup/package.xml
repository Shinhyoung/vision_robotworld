<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roboworld_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files, YAML configuration and CAD assets for the RoboWorld conveyor
    inspection and 6D pose pipeline. The config/ directory is the single source
    of truth read by both the ROS nodes and the plain-Python tools.
  </description>
  <maintainer email="k3i_ai5@k3i.co.kr">RoboWorld Vision Team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>roboworld_core</exec_depend>
  <exec_depend>roboworld_interfaces</exec_depend>
  <exec_depend>roboworld_inspection</exec_depend>
  <exec_depend>roboworld_pipeline</exec_depend>
  <exec_depend>roboworld_pose</exec_depend>
  <exec_depend>roboworld_ros_utils</exec_depend>
  <!-- Optional: only needed when camera_source:=realsense -->
  <exec_depend>realsense2_camera</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
