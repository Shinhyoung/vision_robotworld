<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roboworld_inspection</name>
  <version>0.1.0</version>
  <description>Surface defect inspection node (EfficientAD / statistical backends) serving roboworld_interfaces/InspectPart.</description>
  <maintainer email="k3i_ai5@k3i.co.kr">RoboWorld Vision Team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>roboworld_core</depend>
  <depend>roboworld_interfaces</depend>
  <depend>roboworld_ros_utils</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
